{
  "manifest_version": 3,
  "name": "RevCheck Reader",
  "version": "0.1.0",
  "description": "Lets the RevCheck site read mobile.bg and cars.bg listings from your own browser. Read-only, nothing else.",
  "host_permissions": ["https://www.mobile.bg/*", "https://www.cars.bg/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://georgievalex.github.io/revcheck/*", "http://localhost:8787/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": { "128": "icon128.png" }
}
